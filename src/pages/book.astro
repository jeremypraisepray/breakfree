---
import Layout from '../layouts/Layout.astro';
import FunnelShell from '../components/FunnelShell.astro';
import Arrow from '../components/Arrow.astro';
import site from '../data/site.json';
import img from '../assets/photos/battle-arena.jpg';

const endpoint = site.forms.bookingEndpoint;
const formName = 'book-break-free';
const services = [
  ['live-performance', 'Live performance'],
  ['dj', 'DJ'],
  ['dance', 'Dance'],
  ['school-assembly', 'School assembly'],
  ['corporate-event', 'Corporate event'],
  ['mobile-programming', 'Mobile programming'],
  ['brand-activation', 'Brand activation'],
  ['strategic-partnership', 'Strategic partnership'],
  ['other', 'Other'],
];
const orgTypes = ['School / district', 'Corporation', 'Brand', 'Agency', 'Event producer', 'Venue', 'Museum / library', 'Nonprofit / community', 'Festival', 'Private event', 'Other'];
---
<Layout
  title="Book Break Free"
  description="Book Break Free Worldwide for live hip-hop entertainment, dancers, DJs, school assemblies, corporate events, mobile programming, brand activations and strategic partnerships."
  image={img}
  focus
>
  <FunnelShell
    accent="world"
    image={img}
    imageAlt="A b-boy hits a freeze in the center of an arena battle as judges and the crowd look on."
    imagePos="45% 55%"
    eyebrow="Break Free Worldwide — Entertainment + Partnerships"
    title={['Bring', 'the', 'culture.']}
    lede="Tell us what you're building. We'll shape the experience around your stage, audience and goals."
    perks={['Performances', 'Programming', 'Partnerships']}
  >
    <div class="ff" data-funnel-wrap>
      <div class="ff__top">
        <span class="mono" data-step-count>01 / 03</span>
        <div class="ff__progress" data-progress aria-hidden="true"></div>
      </div>

      <form
        name={formName}
        method="POST"
        action={endpoint || '/book/thanks'}
        data-funnel
        data-endpoint={endpoint}
        data-netlify={endpoint ? undefined : 'true'}
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value={formName} />
        <p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <!-- STEP 1 -->
        <fieldset class="ff__step" data-step>
          <legend><span class="ff__step-title" data-step-title>What are we building?</span></legend>

          <fieldset class="chips">
            <legend class="mono muted">I'm looking to</legend>
            <label class="chip"><input type="radio" name="interest" value="booking" required checked /><span>Book Break Free</span></label>
            <label class="chip"><input type="radio" name="interest" value="partnership" /><span>Start a partnership</span></label>
            <p class="err" aria-live="polite"></p>
          </fieldset>

          <fieldset class="chips" data-require-one>
            <legend class="mono muted">Services — pick any</legend>
            {services.map(([v, l]) => (
              <label class="chip"><input type="checkbox" name="service" value={v} /><span>{l}</span></label>
            ))}
            <p class="err" aria-live="polite"></p>
          </fieldset>

          <div class="field">
            <label for="ffb-org-type">Organization type</label>
            <select id="ffb-org-type" name="organization_type" required>
              <option value="">Choose one</option>
              {orgTypes.map((o) => <option>{o}</option>)}
            </select>
            <p class="err" aria-live="polite"></p>
          </div>

          <div class="ff__nav">
            <span></span>
            <button type="button" class="btn btn--world btn--lg" data-next>Next <Arrow /></button>
          </div>
        </fieldset>

        <!-- STEP 2 -->
        <fieldset class="ff__step" data-step>
          <legend><span class="ff__step-title" data-step-title>The details</span></legend>
          <p class="ff__step-sub">Rough answers are fine — we'll refine together.</p>

          <div class="ff__row" data-show-if="interest=booking">
            <div class="field">
              <label for="ffb-date">Event date</label>
              <input id="ffb-date" name="event_date" type="date" />
              <p class="ff__hint">Leave blank if flexible.</p>
            </div>
            <div class="field">
              <label for="ffb-loc">Location</label>
              <input id="ffb-loc" name="location" autocomplete="address-level2" placeholder="City or venue" data-req />
              <p class="err" aria-live="polite"></p>
            </div>
          </div>

          <div class="ff__row">
            <div class="field">
              <label for="ffb-aud">Estimated audience</label>
              <select id="ffb-aud" name="audience_size">
                <option value="">Choose one</option>
                <option>Under 50</option><option>50 – 150</option><option>150 – 500</option><option>500 – 1,000</option><option>1,000+</option><option>Not sure yet</option>
              </select>
            </div>
            <div class="field">
              <label for="ffb-budget">Budget range</label>
              <select id="ffb-budget" name="budget">
                <option value="">Choose one</option>
                <option>Under $1,000</option><option>$1,000 – $2,500</option><option>$2,500 – $5,000</option><option>$5,000 – $10,000</option><option>$10,000+</option><option>Not sure yet</option>
              </select>
            </div>
          </div>

          <div class="field" data-show-if="interest=partnership">
            <label for="ffb-partner">Partnership interest</label>
            <textarea id="ffb-partner" name="partnership_interest" rows="3" placeholder="Programming, sponsorship, brand collaboration, community initiative…" data-req></textarea>
            <p class="err" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="ffb-desc">Tell us about the project</label>
            <textarea id="ffb-desc" name="description" rows="4" required placeholder="The occasion, the audience, the vibe you're going for…"></textarea>
            <p class="err" aria-live="polite"></p>
          </div>

          <div class="ff__nav">
            <button type="button" class="ff__back" data-back>← Back</button>
            <button type="button" class="btn btn--world btn--lg" data-next>Next <Arrow /></button>
          </div>
        </fieldset>

        <!-- STEP 3 -->
        <fieldset class="ff__step" data-step>
          <legend><span class="ff__step-title" data-step-title>Who are we talking to?</span></legend>

          <div class="ff__row">
            <div class="field">
              <label for="ffb-name">Your name</label>
              <input id="ffb-name" name="name" autocomplete="name" required placeholder="Full name" />
              <p class="err" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="ffb-org">Organization</label>
              <input id="ffb-org" name="organization" autocomplete="organization" required placeholder="Company, school or group" />
              <p class="err" aria-live="polite"></p>
            </div>
          </div>
          <div class="ff__row">
            <div class="field">
              <label for="ffb-email">Email</label>
              <input id="ffb-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
              <p class="err" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="ffb-phone">Phone</label>
              <input id="ffb-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(713) 000-0000" pattern="[0-9()+\-.\s]{7,}" />
              <p class="err" aria-live="polite"></p>
            </div>
          </div>

          <div class="ff__error" data-funnel-error hidden role="alert">
            Something went wrong sending your inquiry. Please try again{site.email ? <> or email <a href={`mailto:${site.email}`}>{site.email}</a></> : ''}.
          </div>

          <div class="ff__nav">
            <button type="button" class="ff__back" data-back>← Back</button>
            <button type="submit" class="btn btn--world btn--lg">Send inquiry <Arrow /></button>
          </div>
        </fieldset>
      </form>
    </div>
  </FunnelShell>

  <section class="success" data-funnel-success hidden aria-live="polite" style="--field-accent: var(--world)">
    <div class="wrap">
      <p class="eyebrow">Inquiry received</p>
      <h2 class="split display" tabindex="-1">
        <span class="line"><span style="--i:0">Let's move<span data-first-name></span><span class="t-world">.</span></span></span>
      </h2>
      <p class="lede" style="margin-top:1.5rem">Thanks for reaching out. Our team will review your request and follow up personally.</p>
      <ol class="success__steps" role="list">
        <li><h3>We review</h3><p class="muted">We look at your date, audience and goals.</p></li>
        <li><h3>We connect</h3><p class="muted">A quick conversation to shape the right experience.</p></li>
        <li><h3>We bring it</h3><p class="muted">Dancers, DJs and programming — delivered with intention.</p></li>
      </ol>
      <div class="success__ctas">
        <a href="/entertainment" class="btn btn--world">See what we do <Arrow /></a>
        <a href="/" class="btn btn--ghost">Back to home <Arrow /></a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/funnel.ts';
  </script>
</Layout>
