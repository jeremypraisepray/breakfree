---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import site from '../data/site.json';
import defaultOg from '../assets/photos/studio-headstand.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** Hide the floating mobile CTA bar (used on the funnel pages). */
  focus?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description = site.description, image = defaultOg, focus = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title} — Break Free Worldwide` : 'Break Free Worldwide — Hip-Hop School & Entertainment · Houston, TX';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site);

const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'PerformingGroup'],
      '@id': `${site.url}/#org`,
      name: site.name,
      url: site.url,
      foundingDate: site.founded,
      foundingLocation: { '@type': 'Place', name: 'Houston, Texas' },
      description: site.description,
      sameAs: site.social.map((s) => s.url).filter(Boolean),
      ...(site.email ? { email: site.email } : {}),
    },
    {
      '@type': ['LocalBusiness', 'EducationalOrganization'],
      '@id': `${site.url}/#school`,
      name: 'Break Free Hip-Hop School',
      parentOrganization: { '@id': `${site.url}/#org` },
      url: `${site.url}/school`,
      image: ogUrl.href,
      ...(site.phone ? { telephone: site.phone } : {}),
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.country,
      },
      areaServed: { '@type': 'City', name: 'Houston' },
      openingHoursSpecification: site.hours.map((h) => ({
        '@type': 'OpeningHoursSpecification', dayOfWeek: h.dayCodes, opens: h.opens, closes: h.closes,
      })),
      makesOffer: { '@type': 'Offer', name: 'First Class Free', price: '0', priceCurrency: 'USD', url: `${site.url}/first-class-free` },
    },
  ],
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Break Free Worldwide" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Houston" />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    {site.announcement.enabled && site.announcement.text && (
      <div class="announce mono">
        <span>{site.announcement.text}</span>
        {site.announcement.link && <a href={site.announcement.link}>{site.announcement.linkLabel || 'Learn more'} →</a>}
      </div>
    )}
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {!focus && (
      <div class="dock" data-dock aria-label="Quick actions" role="region">
        <a href="/first-class-free" class="btn btn--school">First class free <Arrow /></a>
        <a href="/book" class="btn btn--ghost">Book us</a>
      </div>
    )}

    <div class="cursor" aria-hidden="true" data-cursor><span></span></div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style>
  .announce { position: relative; z-index: 101; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 0.65rem 1rem; background: var(--school); color: var(--ink); text-align: center; }
  .announce a { text-decoration: underline; text-underline-offset: 3px; }
  .dock {
    position: fixed; z-index: 90; left: 0.75rem; right: 0.75rem; bottom: max(0.75rem, env(safe-area-inset-bottom));
    display: none; grid-template-columns: 1.6fr 1fr; gap: 0.5rem; padding: 0.5rem;
    background: rgba(10, 10, 10, 0.78); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    border: 1px solid rgba(239, 235, 228, 0.12); border-radius: 999px;
    transform: translateY(calc(100% + 2rem)); transition: transform 0.7s var(--spring);
  }
  .dock .btn { min-height: 3.1rem; font-size: 0.82rem; padding: 0 1.1rem; justify-content: center; }
  :global(.dock-on) .dock { transform: none; }
  @media (max-width: 1000px) { .dock { display: grid; } }
</style>
