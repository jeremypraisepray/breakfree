---
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import bg from '../assets/photos/battle-arena.jpg';
---
<section class="final" aria-labelledby="final-title">
  <div class="final__bg" aria-hidden="true">
    <div class="final__bg-inner" data-parallax="0.18">
      <Photo src={bg} alt="" sizes="100vw" widths={[800, 1280, 1600, 2000]} position="45% 60%" />
    </div>
  </div>
  <div class="wrap final__inner">
    <p class="eyebrow eyebrow--plain mono" data-reveal>The question</p>
    <h2 class="split display display--mega" id="final-title" data-split>
      <span class="line"><span style="--i:0">How will</span></span>
      <span class="line"><span style="--i:1">you break</span></span>
      <span class="line"><span style="--i:2">free<span class="t-school">?</span></span></span>
    </h2>

    <div class="choices">
      <a href="/first-class-free" class="choice choice--school" data-reveal data-cursor-label="Dance">
        <span class="mono choice__k">I want to dance</span>
        <span class="choice__t">First class free</span>
        <Arrow class="choice__arrow" />
      </a>
      <a href="/book" class="choice choice--world" data-reveal style="--d:0.1" data-cursor-label="Book">
        <span class="mono choice__k">I want to work with Break Free</span>
        <span class="choice__t">Entertainment + partnerships</span>
        <Arrow class="choice__arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .final { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(7rem, 14vw, 13rem) clamp(3rem, 6vw, 5rem); min-height: 100svh; display: flex; align-items: flex-end; }
  .final__bg { position: absolute; inset: 0; z-index: -1; }
  .final__bg-inner { position: absolute; inset: -12% 0; transform: translateY(var(--py, 0)); }
  .final__bg-inner :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.6) contrast(1.1) brightness(0.6); }
  .final__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.3) 40%, rgba(10,10,10,0.92) 100%); }
  .final__inner { width: 100%; }
  .final h2 { margin-top: 1.5rem; color: var(--white); }
  .choices { display: grid; grid-template-columns: 1fr 1fr; margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid rgba(239, 235, 228, 0.25); }
  .choice {
    position: relative; display: grid; gap: 0.75rem; padding: 2rem 4.5rem 2rem 1.5rem; isolation: isolate; overflow: hidden;
    transition: color 0.5s var(--ease-out);
  }
  .choice + .choice { border-left: 1px solid rgba(239, 235, 228, 0.25); }
  .choice::before { content: ''; position: absolute; inset: 0; z-index: -1; transform: scaleY(0); transform-origin: bottom; transition: transform 0.7s var(--ease-out); }
  .choice--school::before { background: var(--school); }
  .choice--world::before { background: var(--world); }
  .choice:hover, .choice:focus-visible { color: var(--ink); }
  .choice:hover::before, .choice:focus-visible::before { transform: scaleY(1); }
  .choice__k { opacity: 0.8; }
  .choice__t { font-family: var(--font-display); font-weight: 800; font-variation-settings: 'wdth' 75; text-transform: uppercase; font-size: clamp(1.4rem, 2.4vw, 2.4rem); line-height: 0.95; }
  .choice :global(.choice__arrow) { position: absolute; right: 1.5rem; bottom: 2.1rem; width: clamp(1.75rem, 3vw, 2.75rem); height: auto; transition: transform 0.6s var(--spring); }
  .choice:hover :global(.choice__arrow) { transform: translateX(0.4rem) rotate(-45deg); }
  @media (max-width: 760px) {
    .final h2 { font-size: clamp(2.6rem, 12vw, 4rem); }
    .choices { grid-template-columns: 1fr; gap: 0.6rem; border-top: 0; }
    .choice { border-radius: 1rem; padding: 1.5rem 4rem 1.5rem 1.25rem; background: rgba(239, 235, 228, 0.08); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
    .choice + .choice { border-left: 0; }
    .choice--school { background: var(--school); color: var(--ink); }
    .choice :global(.choice__arrow) { bottom: 1.6rem; }
  }
</style>
