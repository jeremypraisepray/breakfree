---
import site from '../data/site.json';
import Arrow from './Arrow.astro';
const socials = site.social.filter((s) => s.url);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <p class="display display--l footer__claim">Culture.<br />Movement.<br /><span class="outline-text">Freedom.</span></p>
      <div class="footer__ctas">
        <a href="/first-class-free" class="btn btn--school btn--lg" data-magnetic>Get your first class free <Arrow /></a>
        <a href="/book" class="btn btn--ghost btn--lg" data-magnetic>Book Break Free <Arrow /></a>
      </div>
    </div>

    <div class="footer__grid">
      <div>
        <h2 class="mono footer__h">Hip-Hop School</h2>
        <ul role="list">
          <li><a href="/first-class-free">First class free</a></li>
          <li><a href="/school#programs">Programs</a></li>
          <li><a href="/first-class-free?program=private-lessons">Private lessons</a></li>
          <li><a href="/school">The school</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mono footer__h">Worldwide</h2>
        <ul role="list">
          <li><a href="/entertainment">Entertainment</a></li>
          <li><a href="/partnerships">Partnerships</a></li>
          <li><a href="/book">Book Break Free</a></li>
          <li><a href="/news">News &amp; events</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mono footer__h">Visit</h2>
        <address>
          <a href={site.address.mapUrl} target="_blank" rel="noopener">
            {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
          </a>
        </address>
        {site.hours.map((h) => <p class="muted">{h.days}<br />{h.time}</p>)}
      </div>
      <div>
        <h2 class="mono footer__h">Connect</h2>
        <ul role="list">
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          {site.phone && <li><a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a></li>}
          {socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
          <li><a href="/contact">Contact</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__mark" aria-hidden="true">
    <span>Break Free</span>
  </div>

  <div class="wrap footer__bottom mono">
    <span>© {year} Break Free Worldwide</span>
    <span>Houston, Texas — Est. {site.founded}</span>
    <a href="#top" class="footer__top-link">Back to top <Arrow dir="up-right" /></a>
  </div>
</footer>

<style>
  .footer { position: relative; background: var(--ink); border-top: 1px solid rgba(239, 235, 228, 0.1); padding-top: clamp(4rem, 9vw, 8rem); overflow: hidden; }
  .footer__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2.5rem; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .footer__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .footer__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; padding-block: 3rem; border-top: 1px solid rgba(239, 235, 228, 0.12); }
  .footer__h { color: var(--smoke); margin-bottom: 1.1rem; font-weight: 400; }
  .footer__grid li + li { margin-top: 0.35rem; }
  .footer__grid a { display: inline-block; padding-block: 0.15rem; transition: color 0.3s; }
  .footer__grid a:hover { color: var(--school); }
  .footer__grid address { font-style: normal; margin-bottom: 1rem; }
  .footer__mark {
    font-family: var(--font-display); font-weight: 900; font-variation-settings: 'wdth' 62;
    text-transform: uppercase; font-size: 24.5vw; line-height: 0.72; letter-spacing: -0.03em; white-space: nowrap;
    text-align: center; color: var(--charcoal); margin-top: 1rem; user-select: none;
  }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.5rem 2rem; color: var(--smoke); border-top: 1px solid rgba(239, 235, 228, 0.08); position: relative; }
  .footer__top-link { display: inline-flex; gap: 0.5em; align-items: center; }
  .footer__top-link:hover { color: var(--bone); }
  @media (max-width: 800px) {
    .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .footer__ctas, .footer__ctas .btn { width: 100%; }
  }
  @media (max-width: 1000px) { .footer { padding-bottom: 4.5rem; } }
</style>
