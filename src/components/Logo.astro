---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
interface Props { class?: string; size?: number; label?: boolean; eager?: boolean }
const { class: cls = '', size = 52, label = false, eager = true } = Astro.props;
---
<span class={`logo ${cls}`}>
  <Image src={logo} alt="Break Free Worldwide" width={size} height={size} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} class="logo__img" />
  {label && <span class="logo__label mono" aria-hidden="true">Houston, TX<br />Est. 2011</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.75rem; line-height: 1; }
  .logo__img { width: var(--logo-size, 3.25rem); height: auto; transition: transform 0.9s var(--spring); filter: drop-shadow(0 0.25rem 0.75rem rgba(0, 0, 0, 0.35)); }
  a:hover > .logo .logo__img, .logo:hover .logo__img { transform: rotate(-8deg) scale(1.04); }
  .logo__label { color: rgba(239, 235, 228, 0.7); font-size: 0.6rem; line-height: 1.5; }
</style>
