---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`}>
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 40 40"><path d="M5 35 35 5M14 5h21v21" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square"/></svg>
  </span>
  <span class="logo__type">
    <span class="logo__main">Break Free</span>
    <span class="logo__sub">Worldwide</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; line-height: 1; }
  .logo__mark { width: 1.9rem; height: 1.9rem; display: grid; place-items: center; background: var(--bone); color: var(--ink); border-radius: 50%; padding: 0.45rem; transition: transform 0.8s var(--spring); }
  .logo:hover .logo__mark { transform: rotate(45deg); }
  .logo__type { display: grid; gap: 0.18rem; }
  .logo__main { font-family: var(--font-display); font-weight: 800; font-variation-settings: 'wdth' 75; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 0.01em; }
  .logo__sub { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.32em; text-transform: uppercase; opacity: 0.7; }
</style>
