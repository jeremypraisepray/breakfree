---
import { getCollection } from 'astro:content';
import site from '../../data/site.json';
const testimonials = (await getCollection('testimonials', (t) => !t.data.draft)).sort((a, b) => a.data.order - b.data.order);
const partners = (await getCollection('partners', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const pillars = ['Hip-Hop School', 'Performance', 'Entertainment', 'Education', 'Community', 'Culture', 'Creative partnership'];
---
<section class="impact section" aria-labelledby="impact-title">
  <div class="wrap">
    <div class="impact__head">
      <p class="eyebrow" data-reveal>Impact</p>
      <h2 class="display display--l" id="impact-title" data-reveal>A serious creative organization —<br /><span class="muted">with Houston roots and worldwide ambition.</span></h2>
    </div>

    <dl class="impact__stats">
      {site.impact.map((m, i) => (
        <div class="stat" data-reveal style={`--d:${i * 0.08}`}>
          <dt class="mono">{m.label}</dt>
          <dd>
            <span class="stat__value display">{m.value}</span>
            <span class="stat__note muted">{m.note}</span>
          </dd>
        </div>
      ))}
    </dl>

    <p class="impact__pillars" data-reveal aria-label="What Break Free is">
      {pillars.map((p, i) => <span class={i % 2 ? 'outline-text' : ''}>{p}</span>)}
    </p>

    {testimonials.length > 0 && (
      <div class="quotes">
        {testimonials.map((t, i) => (
          <figure class="quote" data-reveal style={`--d:${i * 0.1}`}>
            <blockquote><p>“{t.data.quote}”</p></blockquote>
            <figcaption class="mono"><span class={t.data.path === 'school' ? 't-school' : 't-world'}>—</span> {t.data.name}{t.data.role && <span class="muted">, {t.data.role}</span>}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {partners.length > 0 && (
      <div class="partners">
        <p class="eyebrow">Worked with</p>
        <ul role="list" class="partners__list">
          {partners.map((p) => (
            <li>
              {p.data.url ? <a href={p.data.url} target="_blank" rel="noopener">{p.data.name}</a> : p.data.name}
              {p.data.category && <span class="mono muted">{p.data.category}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .impact { background: var(--ink-2); }
  .impact__head h2 { margin-top: 1.5rem; max-width: 22ch; }
  .impact__head .muted { color: var(--smoke); }
  .impact__stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid rgba(239, 235, 228, 0.14); }
  .stat { padding: 1.5rem 1.5rem 0 0; display: grid; gap: 1rem; }
  .stat + .stat { padding-left: 1.5rem; border-left: 1px solid rgba(239, 235, 228, 0.14); }
  .stat dt { color: var(--smoke); }
  .stat dd { display: grid; gap: 0.75rem; }
  .stat__value { font-size: clamp(3.5rem, 8vw, 8.5rem); line-height: 0.8; }
  .stat:nth-child(1) .stat__value { color: var(--school); }
  .stat:nth-child(4) .stat__value { color: var(--world); }
  .stat__note { font-size: var(--fs-s); max-width: 22ch; }
  .impact__pillars {
    display: flex; flex-wrap: wrap; gap: 0.1em 0.45em; margin-top: clamp(4rem, 8vw, 7rem);
    font-family: var(--font-display); font-weight: 800; font-variation-settings: 'wdth' 72; text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 5rem); line-height: 1;
  }
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 3rem; margin-top: clamp(4rem, 8vw, 7rem); }
  .quote blockquote p { font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.3; font-variation-settings: 'wdth' 90; }
  .quote figcaption { margin-top: 1.25rem; }
  .partners { margin-top: clamp(4rem, 8vw, 7rem); }
  .partners__list { display: flex; flex-wrap: wrap; gap: 1rem 3rem; margin-top: 1.5rem; }
  .partners__list li { display: grid; gap: 0.25rem; font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; text-transform: uppercase; font-variation-settings: 'wdth' 85; }
  @media (max-width: 899px) {
    .impact__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { border-left: 0; padding-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid rgba(239, 235, 228, 0.14); margin-top: 1.5rem; }
  }
</style>
