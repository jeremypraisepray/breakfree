---
import Photo from '../Photo.astro';
import pill from '../../assets/photos/childrens-museum-freeze.webp';
import pill2 from '../../assets/photos/checkerboard-freeze.webp';
const disciplines = ['Hip-Hop School', 'Breaking', 'Live Entertainment', 'DJs', 'School Assemblies', 'Corporate Events', 'Mobile Programming', 'Brand Activations', 'Community'];
---
<section class="intro section section--paper" aria-labelledby="intro-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>More than a dance school</p>
    <h2 class="intro__title display display--xxl" id="intro-title" data-scrub>
      <span class="intro__row intro__row--a">One <span class="intro__pill" aria-hidden="true"><Photo src={pill} alt="" sizes="20vw" widths={[320, 480]} position="50% 30%" /></span> movement.</span>
      <span class="intro__row intro__row--b outline-text">Many ways</span>
      <span class="intro__row intro__row--c">to break <span class="intro__pill intro__pill--alt" aria-hidden="true"><Photo src={pill2} alt="" sizes="20vw" widths={[320, 480]} position="40% 60%" /></span> free.</span>
    </h2>

    <div class="intro__body">
      <p class="lede" data-reveal>
        Break Free Worldwide is a Houston-born hip-hop organization where culture, competition, creativity,
        entertainment, education and community meet.
      </p>
      <p class="muted" data-reveal style="--d:0.1">
        A hip-hop school. A performance company. An educational platform. A creative partner. Since 2011 — one movement with many ways in.
      </p>
    </div>
  </div>

  <div class="intro__marquee marquee" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="marquee__track">
        {disciplines.map((d) => <span>{d}<i>✦</i></span>)}
      </div>
    ))}
  </div>
</section>

<style>
  .intro { padding-bottom: 0; overflow: hidden; }
  .intro__title { margin-top: 2rem; --p: 0.5; }
  .intro__row { display: flex; align-items: center; gap: 0.18em; white-space: nowrap; will-change: transform; }
  .intro__row--a { transform: translateX(calc((0.5 - var(--p)) * 18vw)); }
  .intro__row--b { justify-content: flex-end; transform: translateX(calc((var(--p) - 0.5) * 14vw)); }
  .intro__row--c { transform: translateX(calc((0.5 - var(--p)) * 10vw + 6vw)); }
  .intro__pill { display: inline-block; flex: none; width: 1.9em; height: 0.78em; border-radius: 999px; overflow: hidden; transform: translateY(-0.02em); }
  .intro__pill--alt { width: 1.5em; }
  .intro__pill :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); transition: filter 0.8s var(--ease-out); }
  .intro__title:hover .intro__pill :global(img) { filter: none; }
  .intro__body { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem 4rem; align-items: end; margin-top: clamp(3rem, 7vw, 6rem); max-width: 68rem; margin-left: auto; }
  .intro__body .muted { max-width: 38ch; }
  .intro__marquee { margin-top: clamp(4rem, 9vw, 8rem); padding-block: 1.4rem; background: var(--ink); color: var(--bone); --speed: 45s; }
  .intro__marquee span {
    display: inline-flex; align-items: center; gap: 3rem;
    font-family: var(--font-display); font-weight: 700; font-variation-settings: 'wdth' 85;
    text-transform: uppercase; font-size: clamp(1.2rem, 2.2vw, 2rem); letter-spacing: 0.01em;
  }
  .intro__marquee i { font-style: normal; color: var(--school); font-size: 0.6em; }
  .intro__marquee span:nth-child(3n + 2) i { color: var(--world); }
  @media (max-width: 760px) {
    .intro__title { font-size: clamp(2.6rem, 13.5vw, 5rem); }
    .intro__row { white-space: normal; flex-wrap: wrap; }
    .intro__row--a, .intro__row--b, .intro__row--c { transform: none; justify-content: flex-start; }
    .intro__body { grid-template-columns: 1fr; }
  }
</style>
