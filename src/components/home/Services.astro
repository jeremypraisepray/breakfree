---
import { getCollection } from 'astro:content';
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
const services = (await getCollection('services', (s) => !s.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<section class="services section" aria-labelledby="services-title" data-services>
  <div class="wrap services__head">
    <p class="eyebrow" data-reveal>The experience</p>
    <h2 class="split display display--xl" id="services-title" data-split>
      <span class="line"><span style="--i:0">Everything we</span></span>
      <span class="line"><span style="--i:1" class="outline-text">bring to the floor</span></span>
    </h2>
  </div>

  <div class="wrap services__grid">
    <ol class="services__list" role="list">
      {services.map((s, i) => (
        <li class={`svc svc--${s.data.path}`} data-service>
          <h3 class="svc__heading">
            <button type="button" class="svc__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`svc-${s.id}`}>
              <span class="svc__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__title">{s.data.title}</span>
              <span class="svc__tag mono">{s.data.path === 'school' ? 'School' : 'Worldwide'}</span>
            </button>
          </h3>
          <div class="svc__panel" id={`svc-${s.id}`}>
            <div class="svc__panel-inner">
              <div class="svc__mobile-img media">
                <Photo src={s.data.image} alt={s.data.imageAlt} sizes="100vw" widths={[480, 768, 1080]} />
              </div>
              <p>{s.data.summary}</p>
              <a href={s.data.link} class="link-line">{s.data.path === 'school' ? 'Get started' : 'Learn more'} <Arrow /></a>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="services__stage" aria-hidden="true">
      {services.map((s, i) => (
        <figure class={`stage-fig stage-fig--${s.data.path}`} data-service-figure>
          <Photo src={s.data.image} alt="" sizes="(min-width: 900px) 40vw, 1px" widths={[640, 960, 1280]} />
          <figcaption class="mono">
            <span>{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</span>
            <span>{s.data.highlights.join(' · ')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .services { background: var(--ink-2); }
  .services__head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .services__head h2 { margin-top: 1.5rem; }
  .services__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 6rem); align-items: start; }
  .services__list { border-top: 1px solid rgba(239, 235, 228, 0.14); counter-reset: svc; }
  .svc { border-bottom: 1px solid rgba(239, 235, 228, 0.14); }
  .svc__heading { font: inherit; text-transform: none; }
  .svc__btn {
    width: 100%; display: grid; grid-template-columns: 3rem 1fr auto; align-items: baseline; gap: 1rem;
    padding: clamp(0.9rem, 1.6vw, 1.4rem) 0; text-align: left; color: rgba(239, 235, 228, 0.42);
    transition: color 0.5s var(--ease-out), padding 0.6s var(--ease-out);
  }
  .svc__title {
    font-family: var(--font-display); font-weight: 800; font-variation-settings: 'wdth' 72; text-transform: uppercase;
    font-size: clamp(1.9rem, 4.2vw, 4.4rem); line-height: 0.95; letter-spacing: -0.01em;
    transition: font-variation-settings 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }
  .svc__tag { opacity: 0; transition: opacity 0.4s; }
  .svc.is-lit .svc__btn, .svc.is-active .svc__btn { color: var(--bone); }
  .svc.is-lit .svc__title { font-variation-settings: 'wdth' 92; transform: translateX(0.4rem); }
  .svc.is-lit .svc__tag { opacity: 1; }
  .svc--school.is-lit .svc__num, .svc--school.is-lit .svc__tag { color: var(--school); }
  .svc--world.is-lit .svc__num, .svc--world.is-lit .svc__tag { color: var(--world); }
  .svc__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.7s var(--ease-out); }
  .svc.is-active .svc__panel { grid-template-rows: 1fr; }
  .svc__panel-inner { overflow: hidden; display: grid; gap: 1rem; padding-left: 4rem; }
  .svc__panel-inner > p { max-width: 40ch; color: rgba(239, 235, 228, 0.78); }
  .svc__panel-inner > a { justify-self: start; margin-bottom: 1.5rem; }
  .svc__mobile-img { display: none; }
  .no-js .svc__panel { grid-template-rows: 1fr; }

  .services__stage { position: sticky; top: calc(var(--nav-h) + 2rem); aspect-ratio: 4 / 5; }
  .stage-fig {
    position: absolute; inset: 0; overflow: hidden; background: var(--charcoal);
    clip-path: inset(0 0 100% 0); transition: clip-path 0.9s var(--ease-io);
  }
  .stage-fig.is-active { clip-path: inset(0 0 0 0); z-index: 1; }
  .stage-fig :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.15); transition: transform 1.6s var(--ease-out); }
  .stage-fig.is-active :global(img) { transform: scale(1); }
  .stage-fig figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75)); color: var(--bone);
  }
  .stage-fig--school figcaption span:first-child { color: var(--school); }
  .stage-fig--world figcaption span:first-child { color: var(--world); }

  @media (max-width: 899px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__stage { display: none; }
    .svc__btn { grid-template-columns: 2.25rem 1fr; }
    .svc__tag { display: none; }
    .svc__panel-inner { padding-left: 0; }
    .svc__mobile-img { display: block; aspect-ratio: 16 / 10; margin-top: 0.25rem; }
    .svc__mobile-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  }
</style>
