---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  position?: string;
}
const {
  src, alt, widths = [480, 768, 1080, 1440, 1920], sizes = '100vw', eager = false, class: cls, position,
} = Astro.props;
const w = widths.filter((x) => x <= src.width);
if (!w.length || w[w.length - 1] < src.width) w.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={w}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
  class={cls}
  style={position ? `object-position:${position}` : undefined}
/>
