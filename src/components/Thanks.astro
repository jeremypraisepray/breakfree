---
import Arrow from './Arrow.astro';
interface Props { accent: 'school' | 'world'; eyebrow: string; title: string; lede: string; cta: { href: string; label: string } }
const { accent, eyebrow, title, lede, cta } = Astro.props;
---
<section class="success" style={`--field-accent: var(--${accent})`}>
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display" style="font-size: var(--fs-mega)">{title}<span class={`t-${accent}`}>.</span></h1>
    <p class="lede" style="margin-top:1.5rem">{lede}</p>
    <div class="success__ctas">
      <a href={cta.href} class={`btn btn--${accent}`}>{cta.label} <Arrow /></a>
      <a href="/" class="btn btn--ghost">Back to home <Arrow /></a>
    </div>
  </div>
</section>
