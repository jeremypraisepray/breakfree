---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  accent?: 'school' | 'world' | 'neutral';
  eyebrow: string;
  title: string[];
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePos?: string;
}
const { accent = 'neutral', eyebrow, title, lede, image, imageAlt = '', imagePos } = Astro.props;
---
<section class={`ph ph--${accent} ${image ? 'ph--image' : ''}`} data-hero>
  {image && (
    <div class="ph__media grain">
      <div class="ph__img" data-parallax="0.15">
        <Photo src={image} alt={imageAlt} eager sizes="100vw" position={imagePos} />
      </div>
    </div>
  )}
  <div class="wrap ph__inner">
    <p class="mono ph__eyebrow">{eyebrow}</p>
    <h1 class="display ph__title">
      {title.map((t, i) => (
        <span class="ph__line"><span style={`animation-delay:${i * 0.08}s`} class={i === title.length - 1 && accent !== 'neutral' ? `t-${accent}` : ''} set:html={t} /></span>
      ))}
    </h1>
    {lede && <p class="ph__lede">{lede}</p>}
    <div class="ph__actions"><slot /></div>
  </div>
</section>

<style>
  .ph { position: relative; isolation: isolate; overflow: hidden; padding-top: calc(var(--nav-h) + clamp(4rem, 10vw, 9rem)); padding-bottom: clamp(3rem, 7vw, 6rem); }
  .ph--image { min-height: max(92svh, 640px); display: flex; align-items: flex-end; }
  .ph__media { position: absolute; inset: 0; z-index: -1; }
  .ph__img { position: absolute; inset: -10% 0; transform: translateY(var(--py, 0)); }
  .ph__img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.4) contrast(1.06) brightness(0.75); animation: ph-img 2.4s var(--ease-out) both; }
  .ph__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0.6) 0%, rgba(10,10,10,0.1) 40%, rgba(10,10,10,0.95) 100%); }
  .ph__inner { width: 100%; }
  .ph__eyebrow { color: rgba(239, 235, 228, 0.78); animation: ph-fade 1s 0.4s var(--ease-out) both; }
  .ph--school .ph__eyebrow::first-letter { color: var(--school); }
  .ph__title { font-size: var(--fs-mega); margin-top: 1.25rem; color: var(--white); }
  .ph__line { display: block; overflow: hidden; padding-bottom: 0.03em; }
  .ph__line > span { display: inline-block; animation: ph-rise 1.2s var(--ease-out) both; }
  .ph__lede { margin-top: 1.75rem; max-width: 36ch; font-size: var(--fs-m); line-height: 1.35; color: rgba(239, 235, 228, 0.88); animation: ph-fade 1s 0.5s var(--ease-out) both; }
  .ph__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2.25rem; animation: ph-fade 1s 0.65s var(--ease-out) both; }
  .ph__actions:empty { display: none; }
  @keyframes ph-rise { from { transform: translateY(105%); } }
  @keyframes ph-fade { from { opacity: 0; transform: translateY(1rem); } }
  @keyframes ph-img { from { transform: scale(1.15); } }
  @media (max-width: 700px) {
    .ph__title { font-size: clamp(3.2rem, 16vw, 6rem); }
    .ph__actions :global(.btn) { width: 100%; }
  }
</style>
